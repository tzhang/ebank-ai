# ============================================================
# ebank.ai 环境变量模板 — 复制为 .env 后填写
# 所有密钥只存在于 .env / Vercel Env,禁止硬编码进代码(INF-003)
# ============================================================

# --- 数据库(决策 D4:海外区域 —— Neon 或 Supabase,任一均可) ---
# Neon:  https://neon.tech → 创建项目 → Connect → pooled connection string
# Supabase: https://supabase.com → 创建项目 → Project Settings → Database → Connection string
# 注意:连接串含密码,勿提交;Vercel 的 Preview/Production 分别配置
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- 认证(Auth.js v5 / NextAuth,INF-002,后续 issue 使用) ---
# 生成方式:openssl rand -base64 32
# AUTH_SECRET=""
# GitHub OAuth(M1 AUTH-105):
# https://github.com/settings/developers → New OAuth App(测试/生产两套回调)
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
