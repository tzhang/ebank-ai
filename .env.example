# ============================================================
# ebank.ai 环境变量模板 — 复制为 .env 后填写
# 所有密钥只存在于 .env / Vercel Env,禁止硬编码进代码(INF-003)
# ============================================================

# --- 数据库(决策 D4:海外区域 —— Neon 或 Supabase,任一均可) ---
# Supabase 注意(2026-09 实测):直连端点 db.<ref>.supabase.co 已 IPv6-only,
# 请使用 Connection pooling 的 Session pooler(端口 5432)连接串:
#   postgresql://postgres.<project-ref>:<密码>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# (区域见 Settings → Database → Connection string / supavisor 配置)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# --- 认证(Auth.js v5 / NextAuth,INF-002) ---
# 生成方式:openssl rand -base64 32
AUTH_SECRET=""

# GitHub OAuth(M1 AUTH-105):
# https://github.com/settings/developers → OAuth Apps(本地/生产两套,回调区分)
# 本地:http://localhost:3000/api/auth/callback/github;生产:https://ebank.ai/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- 种子管理员(ADM-120):登录邮箱命中列表即自动提升为 admin,逗号分隔 ---
# ADMIN_EMAILS="admin@ebank.ai"

# --- 站点与邮件(AUTH-102/104) ---
# 站点绝对地址:本地上线域名各环境设置(用于邮件中的链接)
SITE_URL="http://localhost:3000"
# Resend API Key:https://resend.com → API Keys
RESEND_API_KEY="re_..."
# MAIL_MODE="log"  # log = 只打印不真实发送(离线调试);缺省走 Resend
# RESEND_FROM="no-reply@ebank.ai"  # 域名 DNS 验证通过后启用;沙箱期用默认 onboarding@resend.dev(仅可发至账号本人,163/QQ 送达率验收需域名)

# --- 反滥用(AUTH-106):频率限制 + 人机校验 ---
# 频率限制默认开启,阈值见 src/lib/rate-limit.ts 的 POLICIES(注册/登录/找回密码 按 IP 与邮箱两个维度)。
# 本地压测或调试可临时整体关闭(与 MAIL_MODE=log 同一姿态):
# RATE_LIMIT_DISABLED=1

# Cloudflare Turnstile 人机校验(注册表单)。**未配置即休眠**:注册流程不受影响,
# 配好下面两个变量并重新部署后自动生效,无需改代码。
#
# 如何获取密钥(免费,不需要把域名托管到 Cloudflare):
#   1. 注册/登录 https://dash.cloudflare.com
#   2. 左侧栏 Turnstile → Add widget
#   3. 名称填 ebank.ai register;Hostnames 填 ebank.ai、www.ebank.ai(要本地联调再加 localhost);
#      Widget Mode 选 Managed
#   4. 保存后得到 Site Key(公开)与 Secret Key(私密)
#   5. 本地写入本文件对应的 .env;线上加到 Vercel → Project → Settings → Environment
#      Variables(Production,建议连 Preview),然后 Redeploy
#   6. 验证:注册页出现 widget,不勾选直接提交会被拒绝
#
# 没有真密钥也想联调?Cloudflare 提供官方测试密钥(可直接本地验证全链路):
#   永远通过:NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#             TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   永远失败:NEXT_PUBLIC_TURNSTILE_SITE_KEY=2x00000000000000000000AB
#             TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA
# Secret Key 属私密凭据,只放 .env / Vercel,禁止提交仓库。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
